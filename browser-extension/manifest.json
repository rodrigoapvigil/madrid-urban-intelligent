{
  "manifest_version": 3,
  "name": "DMIYC · Importador de anuncios",
  "version": "0.1.0",
  "description": "Importa datos visibles de un anuncio inmobiliario abierto por el usuario en DMIYC.",
  "permissions": ["tabs"],
  "host_permissions": ["https://*.idealista.com/*", "https://*.fotocasa.es/*", "https://*.habitaclia.com/*", "https://*.pisos.com/*", "https://dmiyc.com/*", "https://www.dmiyc.com/*"],
  "content_scripts": [{
    "matches": ["https://*.idealista.com/*", "https://*.fotocasa.es/*", "https://*.habitaclia.com/*", "https://*.pisos.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Importar anuncio en DMIYC" }
}
