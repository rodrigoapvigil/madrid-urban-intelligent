# URL base de la API backend de Madrid Urban Intelligence
NEXT_PUBLIC_API_URL=http://localhost:8001/api
# Producción: https://api.dmiyc.com/api

# Webhook HTTPS de n8n para recibir el formulario de /contacto (solo servidor)
CONTACT_ENDPOINT=
# Dirección destinataria configurada en el workflow de correo (solo servidor)
# Configurar en el entorno de despliegue; no usar una variable NEXT_PUBLIC_.
CONTACT_TO=
